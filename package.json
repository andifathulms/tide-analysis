{
  "name": "pasut",
  "version": "0.1.0",
  "private": true,
  "description": "Tidal harmonic analysis and prediction from real sea level observations",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm records:validate && next build",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:astro": "vitest run tests/astro",
    "test:synthetic": "vitest run tests/synthetic",
    "test:rayleigh": "vitest run tests/rayleigh",
    "records:fetch": "tsx scripts/fetch-records.ts",
    "records:sweep": "tsx scripts/sweep-stations.ts",
    "records:validate": "tsx scripts/validate-records.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "packageManager": "pnpm@9.15.9"
}
